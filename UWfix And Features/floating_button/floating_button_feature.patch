--- app/src/main/java/com/andrerinas/openheadunit/main/MainActivity.kt
+++ app/src/main/java/com/andrerinas/openheadunit/main/MainActivity.kt
@@ +1008,35 @@
+    private fun checkSystemPermissions() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+            val needsOverlay = !android.provider.Settings.canDrawOverlays(this)
+            if (needsOverlay) {
+                systemPermissionDialog = com.google.android.material.dialog.MaterialAlertDialogBuilder(this)
+                    .setTitle("System Permissions Required")
+                    .setMessage("Emzoom AA needs 'Display over other apps' permission to show the Floating Launcher Button on your OEM home screen.")
+                    .setPositiveButton("Grant Permission") { _, _ ->
+                        val intent = Intent(
+                            android.provider.Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
+                            android.net.Uri.parse("package:$packageName")
+                        )
+                        startActivity(intent)
+                    }
+                    .setNegativeButton("Later", null)
+                    .show()
+            }
+        }
+    }
